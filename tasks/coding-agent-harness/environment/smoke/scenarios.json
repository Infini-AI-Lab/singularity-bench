 {
  "id": "prose_turn_is_not_done",
  "task": "config.yaml has the wrong port. Change it to 8080 and record the change in CHANGES.md.",
  "files": {
   "config.yaml": "port: 3000\n",
   "CHANGES.md": "# changes\n"
  },
  "script": [
   {
    "intent": "talk",
    "content": "Let me start by getting my bearings. I'll read config.yaml, change the port, and then write the change down."
   },
   {
    "intent": "read",
    "path": "config.yaml",
    "content": "Reading the config."
   },
   {
    "intent": "talk",
    "content": "The port is 3000 and it should be 8080. Making that edit now."
   },
   {
    "intent": "write",
    "path": "config.yaml",
    "content": "port: 8080\n"
   },
   {
    "intent": "write",
    "path": "CHANGES.md",
    "content": "# changes\n\n- port 3000 -> 8080\n"
   }
  ],
  "expect": {
   "file_is": {
    "config.yaml": "port: 8080\n"
   },
   "file_contains": [
    "CHANGES.md",
    "8080"
   ]
  },
  "seconds": 240
 },
