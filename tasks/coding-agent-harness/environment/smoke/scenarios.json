[
 {
  "id": "reads_then_edits",
  "task": "hello.py greets the wrong name. Read it, fix the greeting to say Ada, and leave a note in FIXED.txt saying what you changed.",
  "files": {
   "hello.py": "def greet():\n    return 'hello, Grace'\n",
   "README.md": "# demo\n"
  },
  "script": [
   {
    "intent": "read",
    "path": "hello.py",
    "content": "Let me look at the file first."
   },
   {
    "intent": "write",
    "path": "hello.py",
    "content": "def greet():\n    return 'hello, Ada'\n"
   },
   {
    "intent": "write",
    "path": "FIXED.txt",
    "content": "changed the greeting from Grace to Ada\n"
   }
  ],
  "expect": {
   "file_is": {
    "hello.py": "def greet():\n    return 'hello, Ada'\n"
   },
   "file_exists": [
    "FIXED.txt"
   ]
  },
  "seconds": 240
 },
 {
  "id": "runs_a_command",
  "task": "Run the project's check script and record whether it passed in RESULT.txt.",
  "files": {
   "check.sh": "#!/bin/sh\necho CHECK_OK\n",
   "RESULT.txt": "unknown\n"
  },
  "script": [
   {
    "intent": "shell",
    "command": "sh check.sh",
    "content": "Running the check."
   },
   {
    "intent": "write",
    "path": "RESULT.txt",
    "content": "passed: CHECK_OK\n"
   }
  ],
  "expect": {
   "file_contains": [
    "RESULT.txt",
    "CHECK_OK"
   ]
  },
  "seconds": 240
 },
