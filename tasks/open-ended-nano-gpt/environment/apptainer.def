# The open-ended-nano-gpt task runtime as an Apptainer image: a step-for-step translation of
# environment/Dockerfile (same base image, pins and steps) for hosts without Docker. Build it with
# environment/build-apptainer.sh, which supplies the pinned Megatron-LM source as "megatron" in the
# build directory, as build.sh does with its build context.
# GB300: native Grace ARM64 userspace and Blackwell-capable CUDA.
Bootstrap: docker
From: nvidia/cuda:12.9.1-cudnn-devel-ubuntu24.04

# %files: the pinned requirements, the Triton assembler fix, the Megatron patch, and the optional Megatron
# library for agent-designed training and evaluation code. The build inputs go to /opt/build-inputs, not /tmp:
# Apptainer mounts a fresh /tmp over the image's during %post. %post removes them.
%files
    requirements.txt /opt/build-inputs/requirements.txt
    triton_ptxas.py /opt/build-inputs/triton_ptxas.py
    patch_megatron.py /opt/build-inputs/patch_megatron.py
    megatron /opt/megatron-lm

%environment
    # CUDA extensions build Blackwell code (10.0) plus PTX; both run on GB300 (10.3).
    export TORCH_CUDA_ARCH_LIST="10.0+PTX"
    export PATH="/opt/venv/bin:${PATH}"
    export VIRTUAL_ENV="/opt/venv"
    export HF_HUB_OFFLINE=1
    export TRANSFORMERS_OFFLINE=1
    export TOKENIZERS_PARALLELISM=false
    export PYTHONUNBUFFERED=1
    export PYTHONPATH=/opt/megatron-lm

%post -c /bin/bash
    set -euo pipefail
    # %post's /tmp is the build host's, often small: temporary files (pip's downloads and builds) go to a directory
    # in the image tree instead, removed at the end.
    mkdir -p /opt/build-tmp
    export TMPDIR=/opt/build-tmp
    # Fail early if the base image is not arm64.
    test "$(dpkg --print-architecture)" = arm64
    export DEBIAN_FRONTEND=noninteractive TORCH_CUDA_ARCH_LIST="10.0+PTX"

    # apt drops privileges to its _apt user for downloads; an unprivileged --fakeroot build maps only one UID,
    # so the downloads run as (fake) root instead. This is an option of these commands, not image configuration.
    apt-get -o APT::Sandbox::User=root update
    apt-get -o APT::Sandbox::User=root install --yes --no-install-recommends \
        python3 \
        python3-dev \
        python3-venv \
        build-essential \
        ca-certificates \
        curl \
        git \
        iptables \
        numactl \
        nodejs \
        npm \
        pciutils \
        procps \
        ripgrep
    rm -rf /var/lib/apt/lists/*

    python3 -m venv /opt/venv
    export PATH="/opt/venv/bin:${PATH}" VIRTUAL_ENV="/opt/venv"
    python -m pip install --no-cache-dir --upgrade pip setuptools wheel
    python -m pip install --no-cache-dir torch==2.9.1 --index-url https://download.pytorch.org/whl/cu129

    python -m pip install --no-cache-dir --requirement /opt/build-inputs/requirements.txt

    python -c 'import torch; assert torch.__version__ == "2.9.1+cu129", torch.__version__; assert torch.version.cuda == "12.9", torch.version.cuda'

    # Triton bundles a CUDA 12.8 ptxas, which cannot target GB300 (sm_103): link it to this image's CUDA 12.9 ptxas.
    python /opt/build-inputs/triton_ptxas.py

    python /opt/build-inputs/patch_megatron.py
    rm -r /opt/build-inputs

    # Breakwater seeds the task tree into /app and starts commands there (Apptainer has no WORKDIR). Tests, the
    # private validation split and LAMBADA reach only the evaluation and verifier stages; never bake them into
    # this image.
    mkdir -p /app/out

    # The coding-agent CLI is installed by Breakwater (breakwater/apptainer/install_cli.py), not here.
    rm -rf /opt/build-tmp
