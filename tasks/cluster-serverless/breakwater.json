{
  "protocol": "breakwater-v1",
  "task": "cluster-serverless",
  "kind": "cluster",
  "workdir": "/app",
  "agent_timeout_sec": 14400.0,
  "evaluation_timeout_sec": 21600,
  "judge_timeout_sec": 10800,
  "agent_deadline": "evaluate",
  "failure_reward": 0.0,
  "judge_model": "accounts/fireworks/models/deepseek-v4p1-flash-1017",
  "workspace_excludes": [],
