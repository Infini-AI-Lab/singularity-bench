# The fleet image (Dockerfile in this directory) as a SIF, for nodes without Docker:
#   apptainer build --fakeroot cluster-fleet.sif apptainer.def   (from this directory, on an arm64 GB300 node)
# bin/cluster.sh runs it with CLUSTER_FLEET_RUNTIME=apptainer and CLUSTER_FLEET_IMAGE=/path/to/cluster-fleet.sif.
Bootstrap: docker
From: vllm/vllm-openai@sha256:61fc8a896b0a4fbbbdc063bc4b0dbc25ce98e02b5050c24aeb7830ac02039b14
# (vllm/vllm-openai:v0.28.0: Apptainer refuses a reference with both a tag and a digest)

%files
    kit /fleet/kit
    entrypoint.sh /fleet/entrypoint.sh

%environment
    export DYN_LOG=warn

%post -c /bin/bash
    set -euo pipefail
    # %post's /tmp is the build host's, often small: temporary files (pip's downloads and builds) go to a directory
    # in the image tree instead, removed at the end.
    mkdir -p /opt/build-tmp
    export TMPDIR=/opt/build-tmp
    # The image ships uvicorn/fastapi but not aiohttp, which both fleet backends use for their own server.
    pip install --no-cache-dir aiohttp==3.14.3
    # Scheduler instrumentation (ai-dynamo's instrumented vLLM scheduler) for the workers' telemetry bridge.
    pip install --no-cache-dir --no-deps ai-dynamo==1.5.0 ai-dynamo-runtime==1.5.0
    pip install --no-cache-dir msgspec==0.19.0 pyzmq==27.1.0
    # Record the installed runtime during build.
    python3 -c "import platform, torch; print('fleet image:', platform.machine(), '| torch', torch.__version__, '| cuda', torch.version.cuda, '| gpu archs', torch.cuda.get_arch_list())"
    chmod +x /fleet/entrypoint.sh
    rm -rf /opt/build-tmp
