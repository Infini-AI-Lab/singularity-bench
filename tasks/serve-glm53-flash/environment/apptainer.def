# The serve-glm53-flash task runtime as an Apptainer image: a step-for-step translation of
# environment/Dockerfile (same base image, pins and steps) for hosts without Docker. Build it with
# environment/build-apptainer.sh, which stages the files the Docker build takes from its context (environment/).
# GB300: native Grace ARM64 userspace and CUDA 13.0, which targets sm_103. Apptainer pulls the base image for the
# build host's architecture (the Dockerfile's --platform=linux/arm64), so build on an aarch64 host.
Bootstrap: docker
From: nvidia/cuda:13.0.1-devel-ubuntu24.04

# The Dockerfile's APT_MIRROR build argument: an optional replacement for the Ubuntu archive URLs, for hosts that
# cannot reach them (apptainer build --build-arg APT_MIRROR=https://MIRROR/ubuntu). Empty keeps the defaults.
%arguments
    APT_MIRROR=

# %files: the FP8 kernel prefetch step (kept at /opt, as in the Dockerfile) and the agent's starting /app. The
# checkpoint is not part of the image: it is mounted read-only at /models/GLM-5.3-Flash at run time.
%files
    prefetch_fp8_kernel.py /opt/prefetch_fp8_kernel.py
    server.py /app/server.py
    serve.sh /app/serve.sh
    start_server.sh /app/start_server.sh
    stop_server.sh /app/stop_server.sh
    example_requests.py /app/example_requests.py
    simulator.py /app/simulator.py
    agentx /app/agentx
    process_safety.md /app/process_safety.md
    instruction.md /app/instruction.md
    CLAUDE.md /app/CLAUDE.md
    AGENTS.md /app/AGENTS.md
    restrict-network.sh /app/restrict-network.sh

%environment
    export DEBIAN_FRONTEND=noninteractive
    # Agent-compiled CUDA extensions get native code for B200 (10.0) and GB300 (10.3).
    export TORCH_CUDA_ARCH_LIST="10.0 10.3"
    # Everything the image needs from the Hugging Face Hub is in its cache; nothing waits on the blocked network.
    export HF_HUB_OFFLINE=1

%post -c /bin/bash
    set -euo pipefail
    # %post's /tmp is the build host's, often small: temporary files (pip's downloads and unpacked wheels, several GB)
    # go to a directory in the image tree instead, removed at the end.
    mkdir -p /opt/build-tmp
    export TMPDIR=/opt/build-tmp
    # Fail early if the base image is not arm64.
    test "$(dpkg --print-architecture)" = arm64
    export DEBIAN_FRONTEND=noninteractive TORCH_CUDA_ARCH_LIST="10.0 10.3"

    apt_mirror="{{ APT_MIRROR }}"
    if [ -n "${apt_mirror}" ]; then
        echo "using apt mirror: ${apt_mirror}"
        sed -i "s|http://archive.ubuntu.com/ubuntu|${apt_mirror}|g; s|http://security.ubuntu.com/ubuntu|${apt_mirror}|g; s|http://ports.ubuntu.com/ubuntu-ports|${apt_mirror}|g" \
            /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true
        sed -i "s|http://archive.ubuntu.com/ubuntu|${apt_mirror}|g; s|http://security.ubuntu.com/ubuntu|${apt_mirror}|g; s|http://ports.ubuntu.com/ubuntu-ports|${apt_mirror}|g" \
            /etc/apt/sources.list 2>/dev/null || true
    fi

    # apt drops privileges to its _apt user for downloads; an unprivileged --fakeroot build maps only one UID,
    # so the downloads run as (fake) root instead. This is an option of these commands, not image configuration.
    # ncu ships in the devel image; nsight-compute and nsight-systems come from Ubuntu noble multiverse.
    apt-get -o APT::Sandbox::User=root update
    # An unprivileged build without /etc/subuid ranges maps only the calling user (as root), and dpkg cannot give
    # package files other owners ("error setting ownership ... Invalid argument"). There, package installs run under
    # fakeroot, which records those ownership changes instead of making them (every file stays root's); it is removed
    # at the end of %post.
    probe=$(mktemp /root/.chown-probe.XXXXXX)
    if chown 1:1 "${probe}" 2>/dev/null; then fakeroot=""; else
        apt-get -o APT::Sandbox::User=root install -y --no-install-recommends fakeroot
        fakeroot="env FAKEROOTDONTTRYCHOWN=1 fakeroot"
        echo "root-mapped build: package installs run under fakeroot"
    fi
    rm -f "${probe}"
    ${fakeroot} apt-get -o APT::Sandbox::User=root install -y --no-install-recommends \
        build-essential python3 python3-pip python3-dev git curl ca-certificates \
        cmake ninja-build iptables iproute2 nsight-compute nsight-systems
    rm -rf /var/lib/apt/lists/*

    # torch is frozen (its speed sets what a server earns on the fixed traffic window) and comes from the CUDA 13.0
    # index; transformers and kernels are pinned together. No vLLM, SGLang, flashinfer or flash-attn.
    pip3 install --break-system-packages --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu130 \
        "torch==2.14.0+cu130"
    pip3 install --break-system-packages --no-cache-dir \
        "transformers[kernels]==5.17.0" "kernels==0.16.0" \
        accelerate fastapi "uvicorn[standard]" numpy safetensors \
        huggingface_hub hf_transfer "aiohttp==3.13.2"
    python3 -m pip check

    # transformers fetches its FP8 kernel from the Hub at first use, and commands have no network at run time:
    # bake it into the image's Hugging Face cache (/root/.cache/huggingface, as in the Dockerfile) and prove that it
    # loads offline.
    python3 /opt/prefetch_fp8_kernel.py

    apt-get -o APT::Sandbox::User=root update
    ${fakeroot} apt-get -o APT::Sandbox::User=root install -y --no-install-recommends procps ripgrep nodejs npm
    rm -rf /var/lib/apt/lists/*

    # tmux: required by terminal-multiplexer agent harnesses.
    apt-get -o APT::Sandbox::User=root update
    ${fakeroot} apt-get -o APT::Sandbox::User=root install -y --no-install-recommends tmux
    rm -rf /var/lib/apt/lists/*

    # Breakwater seeds the task workspace from the image's /app and starts commands there (Apptainer has no
    # WORKDIR).
    mkdir -p /app
    cd /app
    chmod +x /app/serve.sh /app/start_server.sh /app/stop_server.sh
    chmod +x /app/restrict-network.sh

    # Strip apt sources: nothing installs packages at run time.
    rm -rf /etc/apt/sources.list /etc/apt/sources.list.d /var/lib/apt/lists/*

    # The coding-agent CLI is installed by Breakwater (breakwater/apptainer/install_cli.py), not here.

    rm -rf /opt/build-tmp
    # The build's own fakeroot (above), when it needed one, is not part of the image.
    if [ -n "${fakeroot}" ]; then dpkg --purge fakeroot libfakeroot; fi
